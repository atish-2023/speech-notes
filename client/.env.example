# Client environment variables (must be prefixed with VITE_ to be exposed).
#
# Recommended: leave VITE_API_URL and VITE_WS_URL EMPTY. The client then calls
# same-origin '/api' and '/ws', and vite.config.js proxies them to the backend
# at VITE_BACKEND_URL (default http://localhost:5000) for both `vite dev` and
# `vite preview`. No CORS/WS cross-origin setup is needed in that mode.
VITE_API_URL=
VITE_WS_URL=

# Set these ONLY if the client must call the backend directly (e.g. a separate
# deployed API). Use wss:// for the WebSocket when the site is served over HTTPS.
# VITE_API_URL=http://localhost:5000/api
# VITE_WS_URL=ws://localhost:5000/ws/transcribe

# Backend origin the Vite /api and /ws proxy forwards to. Used by `vite dev`
# and `vite preview`. Leave at the default unless the server runs elsewhere.
VITE_BACKEND_URL=http://localhost:5000
