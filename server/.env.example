# Neon PostgreSQL connection string (pooled recommended)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key for Gemini Live transcription
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Client URL for CORS & WebSocket Origin abuse protection
CLIENT_URL=http://localhost:5173

# Server port (Render automatically sets process.env.PORT)
PORT=5000
