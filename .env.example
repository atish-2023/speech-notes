# GEMINI_API_KEY: Required for Gemini Live transcription.
# AI Studio automatically injects this from user secrets, or set it locally.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string from Neon.
# Format: postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# If not set, the app falls back to a safe in-memory store for instant zero-config testing.
DATABASE_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# CLIENT_URL: Client origin for CORS & WebSocket Origin abuse protection (Render deployment)
CLIENT_URL="http://localhost:5173"

# PORT: Server port (defaults to 3000 in AI Studio, 5000 in local standalone, or set by Render)
PORT=3000
